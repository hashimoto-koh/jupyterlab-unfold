{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "target": "ES2018",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*"]
}
